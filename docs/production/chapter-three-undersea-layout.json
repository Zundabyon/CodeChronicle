  "features": [
    {
      "name": "崩れた書庫前の裂け目",
      "bounds": [
        1,
        89,
        78,
        108
      ],
      "description": "幅1の段違いの裂け目。崩れた棚と裂け目の奥の目。白い三本傷をたどる。"
    },
    {
      "name": "泥水の浸水区画",
      "bounds": [
        1,
        77,
        78,
        88
      ],
      "description": "泥水で失われた足場の間を、幅1の堤だけが屈曲して残る。流れに逆らう細い水筋が目印。水は壁背景で表す。"
    },
    {
      "name": "沈船の船腹回廊",
      "bounds": [
        1,
        65,
        78,
        76
      ],
      "description": "折れた船肋を回り込む。朽ちた線路が船腹を縫い、錆びた鎖の向こうに敵が潜む。"
    },
    {
      "name": "骨と本の捨て場",
      "bounds": [
        1,
        53,
        78,
        64
      ],
      "description": "骨と湿った本が壁に押し込まれた廃棄坑。見通しの悪い枝道と、広間へ続く引きずり跡。"
    },
    {
      "name": "暗い海窓の回廊",
      "bounds": [
        1,
        39,
        78,
        52
      ],
      "description": "唯一の長めの幅2の床。黒い海の壁面を見て休める。泉と石板、灯りの帰還点をまとめる。"
    },
    {
      "name": "汚泥の広間への坑道",
      "bounds": [
        1,
        20,
        78,
        38
      ],
      "description": "線路が泥に埋まり、壁の三本傷だけが残る。迂回坑を抜けて、幅1の入口から汚泥の広間へ。"
    },
    {
      "name": "汚泥の広間",
      "bounds": [
        34,
        11,
        46,
        19
      ],
      "description": "骨も本も泥に呑まれる広間。北の首はボスの体だけが塞ぎ、撃破後に浜辺の階段が開く。"
    },
    {
      "name": "向こう岸の浜辺",
      "bounds": [
        32,
        1,
        48,
        8
      ],
      "description": "階段の先の一時的な行き止まり。出口と制作中看板の役割を維持。"
    }
