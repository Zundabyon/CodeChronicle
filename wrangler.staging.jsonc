{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "codechronicle-staging",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-03",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "codechronicle-staging",
      "database_id": "307fea75-898b-4b88-baad-d4ceffea66fd",
      "migrations_dir": "migrations"
    }
  ]
}
