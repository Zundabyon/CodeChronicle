  "sources": [
    {
      "kind": "excerpt",
      "file": "src/content.ts",
      "commit": "7e908ef815db0d64b90d6b063995c343713c933b",
      "fromLine": 14,
      "lines": [
        "export type Question = {",
        "  id: string;",
        "  difficulty: Difficulty;",
        "  topic: 'frontend' | 'laravel' | 'connection';",
        "  track?: Track;",
        "  inertia?: boolean;",
        "  kind: 'choice' | 'cli' | 'fill-choice' | 'fill-input';",
        "  filename?: string;",
        "  prompt: string;",
        "  code?: string;",
        "  options?: [string, string, string, string];",
        "  answer?: number;",
        "  accepted?: string[];",
        "  reveal: string;",
        "  explanation: string;",
        "};",
        "",
        "const choice = (id: string, difficulty: Difficulty, topic: Question['topic'], prompt: string, options: [string,string,string,string], answer: number, explanation: string, extra: Partial<Question> = {}): Question => ({ id, difficulty, topic, kind: 'choice', prompt, options, answer, reveal: options[answer], explanation, ...extra });",
        "const cli = (id: string, difficulty: Difficulty, topic: Question['topic'], prompt: string, accepted: string[], explanation: string, extra: Partial<Question> = {}): Question => ({ id, difficulty, topic, kind: 'cli', prompt, accepted, reveal: accepted[0], explanation, ...extra });",
        "",
        "export const questions: Question[] = [",
        "  choice('r-b-1','beginner','frontend','Reactで画面の一部分を再利用する単位は？',['コンポーネント','マイグレーション','ルート','ミドルウェア'],0,'ReactのUIはコンポーネントを組み合わせて作ります。',{track:'react'}),"
      ]
    },
    {
      "kind": "excerpt",
      "file": "src/App.tsx",
      "commit": "7e908ef815db0d64b90d6b063995c343713c933b",
      "fromLine": 56,
      "lines": [
        "type Phase = 'title' | 'prologue' | 'setup' | 'world' | 'encounter' | 'battle' | 'church' | 'review-room' | 'epilogue' | 'clear';",
        "type Save = { quests:QuestStates; dialogueLog:DialogueLogEntry[]; learningRecords:LearningRecords; version:number; story:StoryStage; name: string; track: Track; difficulty: Difficulty; inertia: boolean; area: Area; pos: Point; hp: number; mp: number; xp: number; level: number; gold:number; inventory:Inventory; equipment:Equipment; dresserOpened:boolean; openedChests:string[]; readBooks:string[]; bookmarks:Record<string,string>; lastSavedAt?:number; defeated: string[]; wrong: string[]; seen: string[]; answered: string[]; bossDefeated: boolean; magicUsed: boolean; completed: boolean; steps: number; correct: number; total: number };",
        "type Dialogue = { study?:QuestStudy; answered?:boolean; correct?:boolean; question?: Question; speaker: string; face: string; lines: (string|StoryLine)[]; index: number; choices?: {label:string; response:string;correct?:boolean;onChoose?:()=>void}[]; onEnd?: () => void };",
        "type Battle = { impact?:BattleImpact; submitted?:string|number; enemy: Enemy; hp: number; maxHp: number; question: Question; answered: boolean; correct: boolean; eliminated: number | null; rounds: number; fromReview?: boolean; banterSeed: number; heroTechnique: HeroTechnique | null; bossStage: number; hints: number };",
        "",
        "const STORAGE = 'code-chronicle-save-v1';",
        "const BACKUP_STORAGE='code-chronicle-save-backup-v1';",
        "const maxHp = (level: number) => 20 + (level - 1) * 5;",
        "const maxMp = (level: number) => 3 + Math.floor((level - 1) / 2);",
        "const rollDamage = (minimum: number, maximum: number) => minimum + Math.floor(Math.random() * (maximum - minimum + 1));",
        "const initialSave = (): Save => ({ quests:{}, dialogueLog:[], learningRecords:{}, version:2, story:'breakfast', name: '旅人', track: 'react', difficulty: 'beginner', inertia: true, area: 'home', pos: maps.home.entry, hp: 20, mp: 3, xp: 0, level: 1, gold:100, inventory:{woodSword:1,travelerClothes:1,herb:1}, equipment:{weapon:'woodSword',armor:'travelerClothes'}, dresserOpened:false, openedChests:[], readBooks:[], bookmarks:{}, defeated: [], wrong: [], seen: [], answered: [], bossDefeated: false, magicUsed: false, completed: false, steps: 0, correct: 0, total: 0 });",
        "const validateIncomingSave=(value:unknown)=>{",
        "  const result=validateSave(value,initialSave());",
        "  if(result.save){",
        "    const restored=restoreMemoryPosition(maps[result.save.area],restoreMapPosition(maps[result.save.area],result.save.pos),result.save.quests);",
        "    if(!same(result.save.pos,restored))result.notice+=' 現在地を通れる場所に戻しました。';",
        "    result.save.pos=restored;",
        "  }",
        "  return result;",
        "};",
        "const loadSave = (storageKey=STORAGE):{save:Save|null;notice:string}=>{",
        "  try {",
        "    const raw=localStorage.getItem(storageKey);if(!raw)return {save:null,notice:''};",
        "    return validateIncomingSave(JSON.parse(raw));",
        "  }catch{return {save:null,notice:'保存データを読み込めませんでした。元のデータは変更していません。'};}"
      ]
    },
